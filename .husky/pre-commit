#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check if there are any staged files
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Check if only documentation/config files changed
ONLY_DOCS=true
for FILE in $STAGED_FILES; do
  case "$FILE" in
    *.md|*.txt|*.json|*.yml|*.yaml|.gitignore|.editorconfig|*.png|*.jpg|*.jpeg|*.gif|*.webp|*.svg|*.ico)
      # Documentation/config/media files - skip
      ;;
    *)
      # Source/test files - need to run checks
      ONLY_DOCS=false
      break
      ;;
  esac
done

# If only docs changed, skip tests and linting
if [ "$ONLY_DOCS" = true ]; then
  echo "📝 Only documentation/config files changed - skipping lint and tests"
  exit 0
fi

# Check if source/test/script files changed
HAS_SOURCE_FILES=false
for FILE in $STAGED_FILES; do
  case "$FILE" in
    src/*|tests/*|scripts/*)
      # Source/test/script files - need to run tests
      HAS_SOURCE_FILES=true
      break
      ;;
    *)
      ;;
  esac
done

# If no source files changed, only run linting (no tests)
if [ "$HAS_SOURCE_FILES" = false ]; then
  echo "⚙️  Only config files changed - running lint only"
  npm run lint
  exit $?
fi

# Source/test files changed - run both lint and tests
echo "🔍 Source/test files changed - running lint and tests"
npm run lint && npm test
